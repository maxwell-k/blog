{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "packageRules": [
    {
      "automerge": true,
      "description": "Automerge changes to .github/workflows/main.yaml",
      "matchFileNames": [".github/workflows/main.yaml"]
    },
    {
      "automerge": true,
      "description": "Automerge allow-listed PyPI packages",
      "matchDatasources": ["pypi"],
      "matchPackageNames": [
        "charset-normalizer",
        "djlint",
        "pytz",
        "rich",
        "six",
        "tqdm",
        "watchfiles"
      ]
    },
    {
      "automerge": true,
      "description": "Automerge development dependencies except renovate",
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["!renovate"]
    },
    {
      "automerge": true,
      "description": "Automerge renovate on a Saturday",
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["renovate"],
      "schedule": ["* 0-3 * * 6"]
    }
  ],
  "poetry": {
    "enabled": false
  }
}
